      "parameters": {
        "jsCode": "// 準備推送數據\nconst webhookData = $('Webhook1').first().json;\n\n// 生成 session ID 如果沒有提供\nlet sessionId = webhookData.body.sessionId;\nif (!sessionId) {\n  sessionId = 'web_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);\n}\n\nreturn {\n  chatInput: webhookData.body.message || webhookData.body.text || '',\n  sessionId: sessionId,\n  userId: sessionId, // 使用 sessionId 作為 userId\n  timestamp: webhookData.body.timestamp || new Date().toISOString(),\n  clientInfo: {\n    userAgent: webhookData.headers['user-agent'] || '',\n    ip: webhookData.headers['x-forwarded-for'] || webhookData.headers['x-real-ip'] || ''\n  }\n};"
      },
      "id": "351ad4c1-0a9b-451c-9200-e46ac28d33bf",
      "name": "Prepare Chat Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        336
      ]
    },
    {
      "parameters": {
        "jsCode": "// 處理 AI 回應並準備回傳 - 支持HTML格式化和正確的URL處理\nconst agentResponse = $('AI Agent').first().json;\nconst prepareData = $('Prepare Chat Data').first().json;\n\n// 嘗試從不同可能的回應欄位獲取文字\nlet responseText = agentResponse.text || \n                  agentResponse.output || \n                  agentResponse.response ||\n                  agentResponse.content ||\n                  '抱歉，我現在無法處理您的請求，請稍後再試。';\n\n// 移除不需要的前綴（如系統提示的要求）\nresponseText = responseText.replace(/^您好！根據查詢到的資訊[，。:]?\\s*/i, '');\n\n// 改進的URL提取和轉換\n// 使用更精確的正則表達式，排除URL後面的括號、句號等標點符號\nconst improvedUrlPattern = /https?:\\/\\/[^\\s\\)\\]\\}。，；：\\n]+(?=[\\s\\)\\]\\}。，；：\\n]|$)/g;\nlet htmlContent = responseText;\n\n// 提取所有有效的URL\nconst urlMatches = responseText.match(improvedUrlPattern) || [];\nconst validUrls = new Set();\n\nurlMatches.forEach(url => {\n  // 清理URL末尾的標點符號\n  let cleanUrl = url.replace(/[.,;:!?\"'\\-]+$/, '');\n  \n  // 驗證URL格式\n  try {\n    new URL(cleanUrl);\n    validUrls.add(cleanUrl);\n  } catch (e) {\n    console.log('Invalid URL detected:', cleanUrl);\n  }\n});\n\n// 替換URL為HTML連結\nhtmlContent = responseText;\nvalidUrls.forEach(url => {\n  // 建立一個更精確的替換模式\n  const escapedUrl = url.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  const urlRegex = new RegExp(escapedUrl, 'g');\n  htmlContent = htmlContent.replace(urlRegex, \n    `<a href=\"${url}\" target=\"_blank\" style=\"color: #3b82f6; text-decoration: underline; word-break: break-all;\">${url}</a>`);\n});\n\n// 轉換Markdown格式為HTML\nlet finalHtml = htmlContent\n  // 保留換行\n  .split('\\n')\n  .map(line => {\n    // 粗體: **text** -> <strong>text</strong>\n    line = line.replace(/\\*\\*(.+?)\\*\\*/g, '<strong style=\"color: #0284c7; font-weight: 600;\">$1</strong>');\n    \n    // 傾斜: *text* -> <em>text</em> (但要避免與URL中的*衝突)\n    line = line.replace(/(?<!:\\/\\/)\\*([^*\\n]+)\\*(?!\\/\\/)/g, '<em style=\"color: #666;\">$1</em>');\n    \n    // 代碼: `text` -> <code>text</code>\n    line = line.replace(/`([^`]+)`/g, '<code style=\"background: #f0f9ff; padding: 2px 6px; border-radius: 4px; color: #0369a1; font-family: monospace; font-size: 12px;\">$1</code>');\n    \n    // 清理開頭的星號和列表項\n    if (line.trim().startsWith('*')) {\n      line = '<li style=\"margin-left: 20px; margin-bottom: 8px;\">' + line.replace(/^\\*\\s*/, '') + '</li>';\n    }\n    \n    return line.trim() ? line : '';\n  })\n  .filter(line => line)\n  .join('<br/>');\n\n// 包裝列表項\nif (finalHtml.includes('<li')) {\n  finalHtml = finalHtml.replace(/(<li[^>]*>.+?<\\/li>)/gs, '<ul style=\"list-style: none; padding: 0;\">$1</ul>');\n  finalHtml = finalHtml.replace(/<\\/ul>\\s*<ul[^>]*>/g, '');\n}\n\n// 如果回應為空，提供預設回應\nif (!finalHtml || finalHtml.trim() === '') {\n  finalHtml = '很抱歉，我現在無法正確理解您的問題。請您換個方式提問，我會盡力為您解答！';\n}\n\nconsole.log('AI Agent 原始回應:', agentResponse);\nconsole.log('提取的有效URL:', Array.from(validUrls));\nconsole.log('HTML格式化後:', finalHtml);\n\nreturn {\n  success: true,\n  message: finalHtml,\n  plainText: responseText,\n  sessionId: prepareData.sessionId,\n  timestamp: new Date().toISOString()\n};"
      },
